# Public, non-secret defaults (committed). Values here are inlined into the app bundle and are
# readable by anyone with the app — never put secrets in EXPO_PUBLIC_* variables (ADR-0011).
# Override locally in .env.local (git-ignored); builds read EAS environment variables.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Error reporting (optional, ADR-0013). Leave empty to keep Sentry off.
EXPO_PUBLIC_SENTRY_DSN=
