{
  "expo": {
    "name": "Starter App",
    "slug": "starter-app-web",
    "version": "1.0.0",
    "scheme": "starterapp",
    "userInterfaceStyle": "automatic",
    "platforms": ["web"],
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
