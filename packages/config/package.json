{
  "name": "@starter/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint, TypeScript and Jest presets for every workspace.",
  "exports": {
    "./eslint": "./eslint.config.js",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./jest": "./jest/create-jest-config.js",
    "./jest/setup": "./jest/setup.js",
    "./jest/style-mock": "./jest/style-mock.js",
    "./env": "./src/env.ts",
    "./observability": "./src/observability/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "eslint-config-expo": "catalog:",
    "eslint-config-prettier": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sentry/react-native": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@sentry/react-native": "*",
    "eslint": "*",
    "expo": "*",
    "expo-constants": "*",
    "jest-expo": "*",
    "react": "*"
  }
}
