{
  "name": "starter-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "mobile": "pnpm --filter @starter/mobile start",
    "web": "pnpm --filter @starter/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm -r test --ci",
    "verify:changed": "pnpm --filter \"...[origin/main]\" --filter \"!starter-app\" lint && pnpm --filter \"...[origin/main]\" --filter \"!starter-app\" typecheck && pnpm format:check && pnpm --filter \"...[origin/main]\" --filter \"!starter-app\" test --ci",
    "test:e2e:mobile": "maestro test e2e/mobile",
    "test:e2e:mobile:smoke": "maestro test --include-tags=smoke e2e/mobile",
    "expo:doctor": "pnpm --filter \"./apps/*\" expo:doctor"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "prettier": "catalog:"
  }
}
